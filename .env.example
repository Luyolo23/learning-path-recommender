# Copy this file to ".env" (same folder) and fill it in. NEVER commit ".env" to GitHub.
# Only needed if you switch on "Let an AI (Groq) write the plan wording" in the app.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional. Groq retires models from time to time: if you get a "model not found"
# error, pick a current model name from https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
